# Required. Firecrawl API key (https://www.firecrawl.dev/app/api-keys?utm_source=election-warroom&utm_medium=integration).
FIRECRAWL_API_KEY=

# Production storage. Leave both empty locally to use an in-memory store.
# Use the service role (or sb_secret_) key. It stays server-side and is never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. The scheduler sends it as "Authorization: Bearer <CRON_SECRET>" to /api/tick.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional
# ELECTION_DATE=2026-11-03
# INGEST_PAUSED=false          # true stops all Firecrawl calls (the dashboard keeps serving the last state)
# ENABLE_MONITORS=true         # false skips the two Firecrawl monitors (about 500 credits/hour)
# FIRECRAWL_ORIGIN=election-warroom
# RESULTS_INTERVAL_MS=20000
# MARKETS_INTERVAL_MS=45000
# NEWS_INTERVAL_MS=45000
# SOURCES_INTERVAL_MS=75000
# NATIONAL_INTERVAL_MS=120000
